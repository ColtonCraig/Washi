{
  "manifest_version": 3,
  "name": "Washi for Dia",
  "short_name": "Washi",
  "version": "1.0.0",
  "description": "Washi's paper look in Dia: a paper new tab with your apps and a note, plus Reader, Snapshot and a sticky note for any site.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Washi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "search",
    "favicon",
    "downloads",
    "clipboardWrite"
  ],
  "commands": {
    "reader": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Reader mode"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "Alt+Shift+W"
      }
    }
  }
}
